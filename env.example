# SimiStream Environment Variables
# Copy this to .env.local and fill in your values

# =========================
# Odyssey-2 Pro API
# =========================
ODYSSEY_API_KEY=your_odyssey_api_key
ODYSSEY_API_BASE_URL=https://api.odyssey.ml

# =========================
# Anthropic (Claude API)
# =========================
# Used for: prompt synthesis, speech-to-sim agent
ANTHROPIC_API_KEY=your_anthropic_api_key

# =========================
# ElevenLabs (v2 — voice)
# =========================
# Not needed for MVP, but set up for when voice is added
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# =========================
# Database (PostgreSQL)
# =========================
DATABASE_URL=postgresql://user:password@localhost:5432/simistream

# =========================
# Redis
# =========================
# Used for: pub/sub (ledger sync), synthesis cache
REDIS_URL=redis://localhost:6379

# =========================
# Auth (NextAuth.js)
# =========================
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# =========================
# WebSocket Server
# =========================
WS_SERVER_URL=ws://localhost:3001
WS_SERVER_PORT=3001

# =========================
# General
# =========================
NODE_ENV=development
